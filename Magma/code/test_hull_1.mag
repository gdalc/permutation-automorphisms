q := 5; //finite field size
n_test := 10; //number of tests for each value of k
Fq := GF(q);
//file used for writing the results
f:=Open("file_path","w");
Write(f, "k, Our, BuiltIn\n");

//function to find code automorphisms when the hull is trivial that relies on finding graph automorphisms
function Auto(G)
	A :=Transpose(G)*(G*Transpose(G))^-1*G;
	n_col:=Ncols(G);
	graph := Digraph<n_col|MatrixRing(Integers(), n_col)!A>;
	auto_group :=  AutomorphismGroup(graph); 
	return auto_group;
end function;

//function to find automorphisms when the hull is trivial and q different from 2
function AutoLabelled(G)
    Amat :=Transpose(G)*(G*Transpose(G))^-1*G;
    n := Nrows(Amat);
    adjac := [ Support(Amat[i]) : i in [1..n] ];
    G := Graph<n | adjac>;
    V := VertexSet(G);
    Elist := [ e : e in EdgeSet(G) ];
    weights := [];
    for e in Elist do
        endv := [ v : v in EndVertices(e) ];
        x := Index(endv[1]);
        y := Index(endv[2]);
        Append(~weights, Amat[x][y]);
    end for;
    m := #Elist;
    newN := n + m;
    newEdges := {};
    for i in [1..m] do
        endv := [ v : v in EndVertices(Elist[i]) ];
        x := Index(endv[1]); y := Index(endv[2]);
        z := n + i;
        Include(~newEdges, {x, z});
        Include(~newEdges, {z, y});
    end for;
    H := Graph<newN | newEdges>;
    VH := VertexSet(H);
    classes := AssociativeArray();
    for v in [1..n] do
        key := Sprint(<false>);
        if not IsDefined(classes, key) then classes[key] := {}; end if;
        Include(~classes[key], v);
    end for;
    for i in [1..m] do
        key := Sprint(<true, weights[i]>);
        if not IsDefined(classes, key) then classes[key] := {}; end if;
        Include(~classes[key], n + i);
    end for;
    P := [ { VH | v : v in classes[k] } : k in Keys(classes) ];
    Aut := AutomorphismGroup(H : Stabilizer := P);
    gens := [ [ i^g : i in [1..n] ] : g in Generators(Aut) ];
    if #gens eq 0 then
        Proj := sub< Sym(n) | Id(Sym(n)) >;
    else
        Proj := sub< Sym(n) | gens >;
    end if;
    return Proj, Aut, H;
end function;

//shorten the code on coordinates in U without deleting columns
function ShortenedCode(G, U, Fq)
	n := Ncols(G);
	k := Nrows(G);
	C:= LinearCode(G);
	H:= ParityCheckMatrix(C);
	H_shorten := ZeroMatrix(Fq, n - k + #U, n);
	InsertBlock(~H_shorten, H, 1, 1);
	for i in [1..#U] do
		H_shorten[n-k+i,U[i]] :=1;
	end for;
return ParityCheckMatrix(LinearCode(H_shorten));
end function;

//Samples permutation if length n = 2*k and with order k
function sample_perm_order(k)
	S2k := Sym(2*k);
	//generate a permutation of S_{2*k} and write it in sequence form
	P := Eltseq(Random(S2k)); 
	cycles:=[];
	for i in [1..k-1] do
		cycles[P[i]] := P[i+1];
	end for;
	cycles[P[k]]:=P[1];

	for i in [1..k-1] do
		cycles[P[k+i]]:=P[k+i+1];
	end for;
	cycles[P[2*k]]:=P[k+1];
	perm:=S2k!cycles;
return perm, PermutationMatrix(Integers(),perm);
end function;


//generate random code whose automorphism group contains P (and its powers). 
//P is sampled as a permutation of length n and order k
function gen_code(Fq, n, k)
	ok := 0;
	while (ok eq 0) do
		cycles, P := sample_perm_order(k);
		P:=ChangeRing(P, Fq);
		G := ZeroMatrix(Fq, k, n);
		a := Vector(Fq, [Random(Fq) : i in [1..n]]);
		G[1]:=a;
		for i in [2..k] do
            		a := a*P;
			G[i]:=a;
		end for;
		if (Rank(G) eq k) then
              		ok := 1;
		end if;
	end while;
	S := RandomMatrix(Fq,k,k);
	while (Rank(S) lt k) do
		S := RandomMatrix(Fq,k,k);
	end while;
	return cycles, P, S*G;
end function;

//check if P is an authomorphism of the code generated by G
function is_an_auto(P,G,H,n,k)
	if (Rank(P) eq n) then
		P:=ChangeRing(P, Fq);
		if (G*P*Transpose(H) eq ZeroMatrix(Fq,k,k)) then
			return 1;
		end if;
	end if;
	return 0;
end function;

//function for slecting the value of k for which it is easy to find a code with a hull of dim hull_dim
function select_k_values(min,max,hull_dim)
k_set := [];
for k in [min.. max] do
	n:=2*k;
	h:= 2000;
	num_attempts:= 0;
	while h ne hull_dim do
		num_attempts := num_attempts+1;
		cycles, P, G := gen_code(Fq, n, k);
		h := k-Rank(G*Transpose(G));
		if num_attempts gt 100000 then
			break;
		end if;
	end while;
	if h eq hull_dim then
		Append(~k_set, k);
	end if;
end for;
return k_set;
end function;

k_set := select_k_values(5,60,1);


for k in k_set do
	n := 2*k;
	our_time :=0; //time for our solver
	builtin_time :=0; //time for built-in function

	for test in [1..n_test] do
		h:= 0;
		//generate a code with hull dimension 1, length n and dim k
		while h ne 1 do
			cycles, P, G := gen_code(Fq, n, k);
			h := k-Rank(G*Transpose(G));
		end while;
		C := LinearCode(G);
		H:=ParityCheckMatrix(C);
		//magma buit-in algorithm
		t1:= Cputime();
		perm_gr:=PermutationGroup(C);
		magma := Cputime(t1);
		builtin_time := builtin_time + magma;
		//our reduction
		true_automorphisms := {}; 
		t2:= Cputime();
		hullC:= Hull(C);
		AllIS:= AllInformationSets(hullC);
		J:= AllIS[1];
		G1:= ShortenedCode(G, J, Fq);
		//reduction part
		for Jfirst in AllIS do
			G2:= ShortenedCode(G, Jfirst, Fq);
			M:= DiagonalJoin(G1,G2);
			C_prod:= LinearCode(M);
			if q eq 2 then
				M_auto_group:= Auto(M);
			else

				M_auto_group:= AutoLabelled(M);
	
			end if;
			for perm in M_auto_group do
				if perm ne Id(M_auto_group) then
					P_prod :=PermutationMatrix(Integers(),perm);
					P := Submatrix(P_prod,1,n+1,n,n);
					if is_an_auto(P,G,H,n,k) eq 1 then
						Include(~true_automorphisms, ChangeRing(P, Fq));
					end if;
				end if;
			end for;
		end for;
		our := Cputime(t2);
		our_time := our_time + our;
		
		/*
		//sanity check
		auto_matrices := {PermutationMatrix(Fq,perm) : perm in perm_gr};
		auto_matrices eq true_automorphisms;
		*/
	end for;

fprintf f, "%o, %o, %o\n", k, RealField()!(our_time/n_test), RealField()!(builtin_time/n_test);
//k, RealField()!(our_time/n_test), RealField()!(builtin_time/n_test);

end for;
delete f;


