q := 5; //finite field size
num_test := 100; //number of tests for each value of k
Fq := GF(q);
//file used for writing the results
f:=Open("file_path","w");
Write(f, "k, Our, BuiltIn\n");

function sample_perm_order(k)
	//Samples permutation if length n = 2*k and with order k. This is done by sampling
    	//two disjoint cycles of length k. The cycles are joined to create a string, then the string is used to create a permutation
    	//of length n = 2*k
	S2k := Sym(2*k);
	//generate a permutation of S_{2*k} and write it in sequence form
	P := Eltseq(Random(S2k)); 
	cycles:=[];
	for i in [1..k-1] do
		cycles[P[i]] := P[i+1];
	end for;
	cycles[P[k]]:=P[1];

	for i in [1..k-1] do
		cycles[P[k+i]]:=P[k+i+1];
	end for;
	cycles[P[2*k]]:=P[k+1];
	perm:=S2k!cycles;
return perm, PermutationMatrix(Integers(),perm);
end function;


function gen_code(Fq, n, k)
	//Generate random code whose automorphism group contains P (and its powers).
	//P is sampled as a permutation of length n and order k
	ok := 0;
	while (ok eq 0) do
		cycles, P := sample_perm_order(k);
		P:=ChangeRing(P, Fq);
		G := ZeroMatrix(Fq, k, n);
		a := Vector(Fq, [Random(Fq) : i in [1..n]]);
		G[1]:=a;
		for i in [2..k] do
            		a := a*P;
			G[i]:=a;
		end for;
		if (Rank(G) eq k) then
              		ok := 1;
		end if;
	end while;

	S := RandomMatrix(Fq,k,k);
	while (Rank(S) lt k) do
		S := RandomMatrix(Fq,k,k);
	end while;
	return cycles, P, S*G;
end function;


function AutoLabelled(Amat)
    n := Nrows(Amat);
    adjac := [ Support(Amat[i]) : i in [1..n] ];
    G := Graph<n | adjac>;
    V := VertexSet(G);

    Elist := [ e : e in EdgeSet(G) ];
    weights := [];
    for e in Elist do
        endv := [ v : v in EndVertices(e) ];
        x := Index(endv[1]);
        y := Index(endv[2]);
        Append(~weights, Amat[x][y]);
    end for;

    m := #Elist;
    newN := n + m;
    newEdges := {};
    for i in [1..m] do
        endv := [ v : v in EndVertices(Elist[i]) ];
        x := Index(endv[1]); y := Index(endv[2]);
        z := n + i;
        Include(~newEdges, {x, z});
        Include(~newEdges, {z, y});
    end for;
    H := Graph<newN | newEdges>;
    VH := VertexSet(H);

    classes := AssociativeArray();
    for v in [1..n] do
        key := Sprint(<false>);
        if not IsDefined(classes, key) then classes[key] := {}; end if;
        Include(~classes[key], v);
    end for;
    for i in [1..m] do
        key := Sprint(<true, weights[i]>);
        if not IsDefined(classes, key) then classes[key] := {}; end if;
        Include(~classes[key], n + i);
    end for;

    P := [ { VH | v : v in classes[k] } : k in Keys(classes) ];

    Aut := AutomorphismGroup(H : Stabilizer := P);

    gens := [ [ i^g : i in [1..n] ] : g in Generators(Aut) ];
    if #gens eq 0 then
        Proj := sub< Sym(n) | Id(Sym(n)) >;
    else
        Proj := sub< Sym(n) | gens >;
    end if;

    return Proj, Aut, H;
end function;


//function for slecting the value of k for which it is easy to find a code with a hull of dim hull_dim
function select_k_values(min,max,hull_dim)
k_set := [];
for k in [min.. max] do
k;
	n:=2*k;
	h:= 2000;
	num_attempts:= 0;
	while h ne hull_dim do
		num_attempts := num_attempts+1;
		cycles, P, G := gen_code(Fq, n, k);
		h := k-Rank(G*Transpose(G));
		if num_attempts gt 100000 then
			break;
		end if;
	end while;
	if h eq hull_dim then
		Append(~k_set, k);
	end if;
end for;
return k_set;
end function;

k_set := select_k_values(10,100,0);
k_set;


for k in [30] do
k;
	n := 2*k;
	
	our := 0; //average time for our solver
	magma_builtin := 0; //average time for built-in function

   	for test in [1.. num_test] do
		//generate code
			h:=1;
			while (h ne 0) do
        		cycles, P, G := gen_code(Fq, n, k);
        		h := k-Rank(G*Transpose(G)); //hull dimension
			end while;
		
			//our reduction
			t1:= Cputime();
			A :=Transpose(G)*(G*Transpose(G))^-1*G; //adjacency matrix
			//directed graph geneation;
			if q eq 2 then
				graph := Digraph<n|MatrixRing(Integers(), n)!A>;
				auto_group :=  AutomorphismGroup(graph); 
			else
				auto_group := AutoLabelled(MatrixRing(Integers(), n)!A);
			end if;
			our_t:=Cputime(t1);
			our := our + our_t;
			
			//now, magma built-in function
			C := LinearCode(G);
			t2 := Cputime();
			gens := PermutationGroup(C);	
			magma :=Cputime(t2);		
			magma_builtin := magma_builtin + magma;

			//validity check 
			if gens ne auto_group then
				print "PROBLEM";
			end if;
			
	end for;

fprintf f, "%o, %o, %o\n", k, RealField()!(our/num_test), RealField()!(magma_builtin/num_test);
//k, RealField()!(our/num_test), RealField()!(magma_builtin/num_test);
end for;
delete f;

